  "notInDemoReasons": [
    {
      "label": "Boons",
      "reason": "The demo does not record boon points. Set these by hand.",
      "sections": ["boons"]
    },
    {
      "label": "Race and Leveling",
      "reason": "Levelling points and race Ability Scores are not in the demo. Race itself is read from the character's costume when recognised.",
      "sections": ["raceLeveling"]
    },
    {
      "label": "Role / Forte / Damage type",
      "reason": "Role, forte and damage type are not recorded; check the Options section.",
      "slotIds": [
        "options.role",
        "options.damageType",
        "options.magnitude",
        "options.forte1",
        "options.forte2a",
        "options.forte2b",
        "options.m32Forte",
