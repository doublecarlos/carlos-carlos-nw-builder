        "options.duration",
        "options.toggleConsumables",
        "options.toggleParty",
        "options.toggleCombat",
        "options.toggleArtifactCall"
      ]
    },
    {
      "label": "Class",
      "reason": "This character's class wasn't recognised from the demo.",
      "slotIds": ["options.class"]
    },
    {
      "label": "Weapon modifications",
      "reason": "Weapon enchant modifications aren't recorded in the demo.",
      "slotIds": ["gear.mainhandMod", "gear.offhandMod1", "gear.offhandMod2"]
    },
    {
      "label": "Reinforcements",
      "reason": "Reinforcement kits aren't recorded in the demo.",
      "sections": ["reinforcements"]
    },
    {
      "label": "Consumable buffs",
      "reason": "Active consumable buffs aren't recorded in the demo.",
      "slotIds": ["buffs.eventFood", "buffs.blessing"]
    },
    {
      "label": "Companion",
      "reason": "The demo only stores a numeric companion index, not which companion it is.",
      "slotIds": ["companions.companion"]
    },
    {
      "label": "Mount and companion bolster",
      "reason": "Bolster comes from your whole stable and companion collection, not from the equipped loadout, so a loadout export has nothing to read it from. Both default to the maximum; set them by hand if your collection is not complete.",
      "slotIds": ["mounts.bolster", "companions.bolster"]
    },
    {
      "label": "Insignia bonuses",
      "reason": "Insignia set-bonus choices aren't recorded in the demo.",
      "slotIds": [
        "insignia.bonus1",
        "insignia.bonus2",
        "insignia.bonus3",
        "insignia.bonus4",
        "insignia.bonus5"
