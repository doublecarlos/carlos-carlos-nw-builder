#!/bin/sh
# Pre-commit hook: runs `npm run verify` to ensure lint, formatting, type checking,
# and tests all pass before allowing a commit.

echo "Running pre-commit verification..."

FAILED_MESSAGES=()

if ! npm run lint:check; then FAILED_MESSAGES+=("ESlint"); fi

if ! npm run format:check; then FAILED_MESSAGES+=("Prettier"); fi

if ! npm run typecheck; then FAILED_MESSAGES+=("Typecheck"); fi

if ! npm run test; then FAILED_MESSAGES+=("Vitest"); fi

if (( ${#FAILED_MESSAGES[@]} > 0 )); then
  echo ""
  echo "❌ Pre-commit verification failed."
  echo ""
  echo "The following checks did not pass:"
  for message in "${FAILED_MESSAGES[@]}"; do
    echo "  - ${message}"
  done
  exit 1
fi

echo "✅ Pre-commit verification passed."
