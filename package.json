{
  "name": "neverwinter-web-builder",
  "version": "1.0.0",
  "description": "Neverwinter build planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "port": "tsx ports.ts",
    "fix": "npm run regen-data && prettier --write . && eslint . --fix --cache",
    "regen-data": "tsx scripts/regen-data.ts",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doublecarlos/yet-another-nw-builder.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/doublecarlos/yet-another-nw-builder/issues"
  },
  "homepage": "https://github.com/doublecarlos/yet-another-nw-builder#readme",
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
